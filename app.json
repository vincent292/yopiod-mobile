{
  "expo": {
    "name": "yopido.shop",
    "slug": "yopido-shop",
    "scheme": "yopido",
    "version": "1.1.21",
    "orientation": "portrait",
    "icon": "./assets/yopido-icon-dark-1024.png",
    "backgroundColor": "#12355B",
    "primaryColor": "#12355B",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "shop.yopido.app",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#12355B",
        "foregroundImage": "./assets/yopido-icon-dark-1024.png",
        "monochromeImage": "./assets/yopido-icon-dark-1024.png"
      },
      "package": "shop.yopido.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": true,
      "versionCode": 23
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "react-native-maps",
        {}
      ],
      [
        "expo-camera",
        {
          "barcodeScannerEnabled": true,
          "cameraPermission": "Permite que Yopido use la camara para escanear QR grupales.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite que Yopido acceda a tus fotos para subir QR y comprobantes de pago.",
          "cameraPermission": "Permite que Yopido use la camara para registrar comprobantes de pago.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permite que Yopido use tu ubicacion para mostrar restaurantes cercanos y calcular entregas."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#B7FF00",
          "defaultChannel": "order-status",
          "icon": "./assets/yopido-notification-icon.png"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#12355B",
          "image": "./assets/yopido-icon-dark-1024.png",
          "imageWidth": 148,
          "resizeMode": "contain"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ec07ea77-ce7e-4a51-9aa5-7adcf1181776"
      }
    },
    "owner": "vins-dev"
  }
}
